{
  "name": "arc40",
  "version": "0.1.0",
  "private": true,
  "description": "Arc40: a local-only personal finance tracker with a high-tech dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/src/main.ts",
    "dev:server": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/src/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check:data": "node scripts/check-no-data.mjs --all",
    "reset-password": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/reset-password.ts",
    "prepare": "node scripts/install-hooks.mjs",
    "demo:data": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/generate-demo-data.ts",
    "demo": "npm run demo:data && npm run build && ARC40_PORT=4041 ARC40_DATA_DIR=demo-data ARC40_BACKUPS=off npm start",
    "restore": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx scripts/restore.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
